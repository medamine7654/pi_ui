{% extends 'base.html.twig' %}

{% block title %}Home - RentAll{% endblock %}

{% block body %}
{# Hero Section with Gradient Background #}
<div class="relative overflow-hidden bg-gradient-to-br from-purple-600 via-pink-500 to-orange-400 pb-20">
    {# Animated Background Elements #}
    <div class="absolute inset-0 opacity-20">
        <div class="absolute top-20 left-10 w-72 h-72 bg-white rounded-full mix-blend-overlay filter blur-3xl animate-pulse"></div>
        <div class="absolute bottom-20 right-10 w-96 h-96 bg-white rounded-full mix-blend-overlay filter blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
    </div>
    
    <div class="container mx-auto px-4 pt-20 pb-32 relative z-10">
        <div class="text-center max-w-4xl mx-auto animate-fade-in">
            <h1 class="text-6xl md:text-7xl font-extrabold text-white mb-6 leading-tight">
                Discover Your Next
                <span class="block bg-gradient-to-r from-yellow-200 to-pink-200 bg-clip-text text-transparent">
                    Adventure
                </span>
            </h1>
            <p class="text-xl md:text-2xl text-white/90 mb-10 leading-relaxed">
                Rent amazing stays, tools, and book professional services all in one place
            </p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a href="{{ path('app_logements') }}" class="group px-8 py-4 bg-white text-purple-600 rounded-2xl font-bold text-lg hover:shadow-2xl hover:scale-105 transition-all duration-300 flex items-center justify-center gap-2">
                    <i class="fas fa-home"></i>
                    <span>Explore Stays</span>
                    <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                </a>
                <a href="{{ path('app_services') }}" class="px-8 py-4 bg-white/10 backdrop-blur-sm text-white border-2 border-white rounded-2xl font-bold text-lg hover:bg-white/20 hover:scale-105 transition-all duration-300 flex items-center justify-center gap-2">
                    <i class="fas fa-briefcase"></i>
                    <span>Browse Services</span>
                </a>
                <a href="{{ path('app_tools') }}" class="px-8 py-4 bg-white/10 backdrop-blur-sm text-white border-2 border-white rounded-2xl font-bold text-lg hover:bg-white/20 hover:scale-105 transition-all duration-300 flex items-center justify-center gap-2">
                    <i class="fas fa-tools"></i>
                    <span>Rent Tools</span>
                </a>
            </div>
        </div>
    </div>
    
    {# Wave Divider #}
    <div class="absolute bottom-0 left-0 right-0">
        <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
            <path d="M0 120L60 105C120 90 240 60 360 45C480 30 600 30 720 37.5C840 45 960 60 1080 67.5C1200 75 1320 75 1380 75L1440 75V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z" fill="#F9FAFB"/>
        </svg>
    </div>
</div>

{# Features Section #}
<div class="container mx-auto px-4 -mt-16 relative z-20 mb-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {# Feature Card 1 #}
        <div class="bg-white rounded-3xl shadow-xl p-8 hover-lift border border-gray-100">
            <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-2xl flex items-center justify-center mb-6 shadow-lg">
                <i class="fas fa-home text-white text-3xl"></i>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">Unique Stays</h3>
            <p class="text-gray-600 leading-relaxed mb-4">
                Discover handpicked properties from cozy studios to luxury villas. Find your perfect home away from home.
            </p>
            <a href="{{ path('app_logements') }}" class="inline-flex items-center gap-2 text-blue-600 font-semibold hover:gap-3 transition-all">
                <span>Explore stays</span>
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>

        {# Feature Card 2 #}
        <div class="bg-white rounded-3xl shadow-xl p-8 hover-lift border border-gray-100">
            <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-pink-500 rounded-2xl flex items-center justify-center mb-6 shadow-lg">
                <i class="fas fa-tools text-white text-3xl"></i>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">Rent Tools</h3>
            <p class="text-gray-600 leading-relaxed mb-4">
                Access professional tools without the hefty price tag. From power drills to garden equipment.
            </p>
            <a href="{{ path('app_tools') }}" class="inline-flex items-center gap-2 text-purple-600 font-semibold hover:gap-3 transition-all">
                <span>Browse tools</span>
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>

        {# Feature Card 3 #}
        <div class="bg-white rounded-3xl shadow-xl p-8 hover-lift border border-gray-100">
            <div class="w-16 h-16 bg-gradient-to-br from-orange-500 to-red-500 rounded-2xl flex items-center justify-center mb-6 shadow-lg">
                <i class="fas fa-briefcase text-white text-3xl"></i>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">Book Services</h3>
            <p class="text-gray-600 leading-relaxed mb-4">
                Connect with skilled professionals for plumbing, electrical work, cleaning, and more.
            </p>
            <a href="{{ path('app_services') }}" class="inline-flex items-center gap-2 text-orange-600 font-semibold hover:gap-3 transition-all">
                <span>Find services</span>
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

{# Stats Section #}
<div class="bg-gradient-to-r from-gray-900 to-gray-800 py-16 mb-20">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
            <div class="animate-fade-in">
                <div class="text-5xl font-bold text-white mb-2">1000+</div>
                <div class="text-gray-400 font-medium">Active Listings</div>
            </div>
            <div class="animate-fade-in" style="animation-delay: 0.1s;">
                <div class="text-5xl font-bold text-white mb-2">500+</div>
                <div class="text-gray-400 font-medium">Happy Customers</div>
            </div>
            <div class="animate-fade-in" style="animation-delay: 0.2s;">
                <div class="text-5xl font-bold text-white mb-2">50+</div>
                <div class="text-gray-400 font-medium">Cities</div>
            </div>
            <div class="animate-fade-in" style="animation-delay: 0.3s;">
                <div class="text-5xl font-bold text-white mb-2">24/7</div>
                <div class="text-gray-400 font-medium">Support</div>
            </div>
        </div>
    </div>
</div>

{# CTA Section #}
<div class="container mx-auto px-4 mb-20">
    <div class="bg-gradient-to-br from-purple-600 to-pink-600 rounded-3xl p-12 md:p-16 text-center shadow-2xl relative overflow-hidden">
        <div class="absolute inset-0 opacity-10">
            <div class="absolute top-0 left-0 w-64 h-64 bg-white rounded-full filter blur-3xl"></div>
            <div class="absolute bottom-0 right-0 w-96 h-96 bg-white rounded-full filter blur-3xl"></div>
        </div>
        <div class="relative z-10">
            <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
                Ready to Start Earning?
            </h2>
            <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
                List your property, tools, or services and start making money from your unused assets today.
            </p>
            <a href="{{ path('app_login') }}" class="inline-flex items-center gap-3 px-10 py-5 bg-white text-purple-600 rounded-2xl font-bold text-lg hover:shadow-2xl hover:scale-105 transition-all duration-300">
                <i class="fas fa-rocket"></i>
                <span>Become a Host</span>
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

{# How It Works Section #}
<div class="container mx-auto px-4 mb-20">
    <div class="text-center mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">How It Works</h2>
        <p class="text-xl text-gray-600">Get started in three simple steps</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
            <div class="relative inline-block mb-6">
                <div class="w-24 h-24 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-full flex items-center justify-center shadow-xl">
                    <span class="text-4xl font-bold text-white">1</span>
                </div>
                <div class="absolute -top-2 -right-2 w-8 h-8 bg-yellow-400 rounded-full flex items-center justify-center">
                    <i class="fas fa-search text-white text-sm"></i>
                </div>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">Search & Discover</h3>
            <p class="text-gray-600">Browse through thousands of listings to find exactly what you need</p>
        </div>
        
        <div class="text-center">
            <div class="relative inline-block mb-6">
                <div class="w-24 h-24 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full flex items-center justify-center shadow-xl">
                    <span class="text-4xl font-bold text-white">2</span>
                </div>
                <div class="absolute -top-2 -right-2 w-8 h-8 bg-green-400 rounded-full flex items-center justify-center">
                    <i class="fas fa-calendar-check text-white text-sm"></i>
                </div>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">Book Instantly</h3>
            <p class="text-gray-600">Reserve your stay, tool, or service with just a few clicks</p>
        </div>
        
        <div class="text-center">
            <div class="relative inline-block mb-6">
                <div class="w-24 h-24 bg-gradient-to-br from-orange-500 to-red-500 rounded-full flex items-center justify-center shadow-xl">
                    <span class="text-4xl font-bold text-white">3</span>
                </div>
                <div class="absolute -top-2 -right-2 w-8 h-8 bg-blue-400 rounded-full flex items-center justify-center">
                    <i class="fas fa-star text-white text-sm"></i>
                </div>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">Enjoy & Review</h3>
            <p class="text-gray-600">Have a great experience and share your feedback with the community</p>
        </div>
    </div>
</div>
{% endblock %}
